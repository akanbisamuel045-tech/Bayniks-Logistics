# ==============================================================================
# Bayniks Nigerian Real-Time Logistics Platform — Production Environment Configuration
# ==============================================================================

# Core System Environment
NODE_ENV=production
PORT=4000
PUBLIC_WEB_URL=https://bayniks.ng
ALLOWED_ORIGINS=https://bayniks.ng,https://admin.bayniks.ng,https://rider.bayniks.ng

# Database Invariant: MongoDB 7.0+ Replica Set (rs0 mandatory for multi-document ACID transactions)
# Golden Rule 6: Escrow locking, wallet debits, and split disbursements require replica set transactions
MONGODB_URI=mongodb://mongo1.bayniks.internal:27017,mongo2.bayniks.internal:27017,mongo3.bayniks.internal:27017/logistics_production?replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=true&w=majority

# Redis 7.0+ In-Memory Telemetry & Geospatial Clustering
# Golden Rule 4 & 5: Live GPS pings, GEOSEARCH dispatch index, and sliding-window rate limiters
REDIS_URL=redis://:strong_redis_password@redis.bayniks.internal:6379/0

# Security & JSON Web Tokens
JWT_SECRET=super_secure_random_production_jwt_secret_min_64_chars_length_xyz123
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secure_random_production_refresh_token_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d

# Paystack API Credentials (NGN Direct Debits, Dedicated Virtual Accounts & Commercial Bank Transfers)
# Used for customer wallet topups, escrow locks, and rider/fleet owner automated payouts
PAYSTACK_SECRET_KEY=sk_live_production_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_production_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=sk_live_production_paystack_secret_key_here

# Termii Multi-Channel Messaging (DND Direct Routes & WhatsApp Business Cloud API)
# Used for instantaneous zero-install live tracking links & secret 4-digit pickup/delivery PIN dispatch
TERMII_API_KEY=live_termii_api_key_production_here
TERMII_SENDER_ID=BAYNIKS
TERMII_BASE_URL=https://api.ng.termii.com

# Google Maps Platform / Mapbox GL Distance Matrix & Geocoding
# Golden Rule 4: [lng, lat] coordinate ordering conversion layer
GOOGLE_MAPS_API_KEY=AIzaSyProductionKey_NigerianGeocoding_Here

# Next.js Customer Web Client Environment Variables
NEXT_PUBLIC_API_URL=https://api.bayniks.ng
NEXT_PUBLIC_SOCKET_URL=https://api.bayniks.ng
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyProductionKey_NigerianGeocoding_Here
