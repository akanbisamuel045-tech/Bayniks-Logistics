# ==============================================================================
# Bayniks Logistics API — MongoDB Atlas + Redis Configuration
# Copy this file to `apps/api/.env` and fill in your credentials.
# ==============================================================================

NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# 1. MongoDB Atlas Connection String (Replica Set enabled automatically by Atlas)
# In MongoDB Atlas: Database -> Connect -> Drivers -> Copy SRV URI and replace <password>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/logistics_db?retryWrites=true&w=majority&appName=bayniks-api

# 2. Redis Connection String (Required for 5s GPS tracking, OTPs & Socket.IO)
# Use Upstash (`rediss://...`), Redis Cloud (`redis://...`), or local Docker (`redis://127.0.0.1:6379`)
REDIS_URL=redis://127.0.0.1:6379

# 3. Security & JSON Web Tokens (change before production!)
JWT_SECRET=bayniks_dev_jwt_secret_minimum_64_characters_change_for_prod_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=bayniks_dev_refresh_secret_minimum_64_characters_change_prod_2026
JWT_REFRESH_EXPIRES_IN=30d

# 4. Nigerian Payment & SMS Gateways (Optional for local testing)
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret
PAYSTACK_WEBHOOK_SECRET=sk_test_replace_with_paystack_secret
TERMII_API_KEY=replace_with_termii_api_key
TERMII_SENDER_ID=BAYNIKS
TERMII_BASE_URL=https://api.ng.termii.com
GOOGLE_MAPS_API_KEY=

